+def concat_segments_xfade(
+    segment_paths: list[Path],
+    durations: list[float],
+    out_path: Path,
+    xfade_dur: float,
+    preview: bool = False,
+) -> None:
+    """Concat with a short crossfade (video dissolve + audio acrossfade) at every
+    junction, instead of a hard cut. Smooths jump cuts on single-take talking
+    heads. Requires a re-encode (xfade is a filtergraph op, not stream copy).
+
+    Total output length = sum(durations) - (N-1) * xfade_dur, because each of the
+    N-1 junctions overlaps the two clips by `xfade_dur`. The subtitle builder must
+    use the same overlap so cues stay aligned (see build_subs.py crossfade_s).
+    """
+    n = len(segment_paths)
+    inputs: list[str] = []
+    for p in segment_paths:
+        inputs += ["-i", str(p)]
+
+    vparts: list[str] = []
+    aparts: list[str] = []
+    prev_v = "[0:v]"
+    prev_a = "[0:a]"
+    cum = durations[0]
+    for i in range(1, n):
+        offset = max(0.0, cum - xfade_dur)
+        vout = f"[vx{i}]"
+        aout = f"[ax{i}]"
+        vparts.append(
+            f"{prev_v}[{i}:v]xfade=transition=fade:"
+            f"duration={xfade_dur:.3f}:offset={offset:.3f}{vout}"
+        )
+        aparts.append(f"{prev_a}[{i}:a]acrossfade=d={xfade_dur:.3f}{aout}")
+        prev_v, prev_a = vout, aout
+        cum = cum + durations[i] - xfade_dur
+
+    filter_complex = ";".join(vparts + aparts)
+    preset, crf = ("medium", "22") if preview else ("fast", "20")
+    cmd = [
+        "ffmpeg", "-y",
+        *inputs,
+        "-filter_complex", filter_complex,
+        "-map", prev_v, "-map", prev_a,
+        "-c:v", "libx264", "-preset", preset, "-crf", crf,
+        "-pix_fmt", "yuv420p", "-r", OUTPUT_FPS,
+        "-c:a", "aac", "-b:a", "192k", "-ar", "48000",
+        "-movflags", "+faststart",
+        str(out_path),
+    ]
+    print(f"xfade-concat ({xfade_dur*1000:.0f}ms) → {out_path.name}")
+    subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
+
